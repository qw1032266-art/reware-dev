MM2Tab:CreateSection("Auto Farming", 6035122244)

local autoFarmActive = false

-- Helper function to check if an MM2 round is currently active
local function IsRoundActive()
    local success, active = pcall(function()
        if ReplicatedStorage:FindFirstChild("RoundActive") then
            return ReplicatedStorage.RoundActive.Value
        elseif Workspace:FindFirstChild("RoundActive") then
            return Workspace.RoundActive.Value
        end
        
        local gui = LocalPlayer:FindFirstChild("PlayerGui")
        if gui and gui:FindFirstChild("MainGUI") then
            local gameHolder = gui.MainGUI:FindFirstChild("Game")
            if gameHolder and gameHolder:FindFirstChild("Timer") then
                local timerText = gameHolder.Timer.Text
                if timerText and timerText ~= "" and not string.match(timerText, "Intermission") and not string.match(timerText, "Voting") then
                    return true
                end
            end
        end
        
        return Workspace:FindFirstChild("Map") ~= nil
    end)
    return success and active or false
end

MM2Tab:CreateToggle({
    Name = "Auto-Farm Coins (Round Check, Noclip, Speed 25)",
    CurrentValue = false,
    Flag = "AutoFarmCoins",
    Image = 6035122244,
    Callback = function(Value)
        autoFarmActive = Value
        
        -- Separate task dedicated strictly to movement, speed, and noclip handling
        task.spawn(function()
            while autoFarmActive do
                task.wait(0.1)
                pcall(function()
                    local character = LocalPlayer.Character
                    if not character then return end
                    local humanoid = character:FindFirstChildOfClass("Humanoid")
                    local rootPart = character:FindFirstChild("HumanoidRootPart")
                    if not humanoid or not rootPart or humanoid.Health <= 0 then return end

                    -- 1. Apply Noclip continuously while toggle is on
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    -- 2. Check if round is active before attempting to gather coins
                    if not IsRoundActive() then
                        return
                    end

                    -- 3. Lock speed to user's preferred safe speed (25)
                    humanoid.WalkSpeed = 25

                    -- 4. Find the closest coin in the workspace
                    local nearestCoinPart = nil
                    local shortestDistance = math.huge

                    for _, obj in ipairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if obj.Name == "Coin" or obj.Name == "Coin_Server" or (obj:IsA("BasePart") and obj.Parent and (obj.Parent.Name == "CoinContainer" or obj.Parent.Name == "Normal")) then
                            local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart")
                            if part then
                                local dist = (rootPart.Position - part.Position).Magnitude
                                if dist < shortestDistance then
                                    shortestDistance = dist
                                    nearestCoinPart = part
                                end
                            end
                        end
                    end

                    -- 5. Move directly underneath the coin (offset down by 3 studs)
                    if nearestCoinPart and nearestCoinPart.Parent then
                        local underCoinPos = nearestCoinPart.Position - Vector3.new(0, 3, 0)
                        humanoid:MoveTo(underCoinPos)
                    end
                end)
            end
            
            -- Reset speed and collision back to normal when toggled off
            pcall(function()
                if LocalPlayer.Character then
                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 16
                        hum:MoveTo(LocalPlayer.Character.HumanoidRootPart.Position)
                    end
                    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
            end)
        end)
    end,
})

